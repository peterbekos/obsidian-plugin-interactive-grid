{
  "name": "interactive-grid",
  "version": "1.0.0",
  "private": true,
  "description": "Arrange and resize cards on interactive grids inside Markdown notes.",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm test && npm run build && node scripts/check-release.mjs",
    "demo": "npm run build && node scripts/install-demo.mjs",
    "package": "npm run check && node scripts/check-release.mjs --stage",
    "test:obsidian": "node scripts/smoke-obsidian.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "1.5.7",
    "playwright-core": "1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "markdown-it": "^14.3.3"
  }
}
