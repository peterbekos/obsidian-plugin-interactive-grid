{
  "name": "interactive-grid",
  "version": "1.0.0",
  "private": true,
  "description": "Arrange and resize cards on interactive grids inside Markdown notes.",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm test && npm run build && node scripts/check-release.mjs",
    "demo": "npm run build && node scripts/install-demo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^8.72.2",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.1",
    "eslint-plugin-obsidian": "^2.33.0",
    "obsidian": "^1.5.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "markdown-it": "^14.3.3"
  }
}
